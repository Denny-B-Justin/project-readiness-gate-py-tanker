# Copy to .env (gitignored) and fill in. Variables already set in the
# environment take precedence over this file.

# Which model client answers: "WB-mAI" (default, the Posit mAI Gateway) or
# "fake" (offline, deterministic replies; no gateway needed). With "WB-mAI"
# the app refuses to start unless MAI_BASE_URL and MAI_ENDPOINT are set and
# it runs on Posit Connect (which provides CONNECT_CONTENT_GUID).
PCN_AI_PROVIDER=WB-mAI

# --- The three mAI settings. On Posit Connect set them under
# --- Settings -> Runtime -> Environment Variables. Leave Integrations empty.
# The gateway authenticates the app: there is no key or token to set.
# 1) Gateway URL for your environment (keep the trailing "/").
#    QA:         https://apiqa2.worldbank.org/posit-mai/conversationalai/
#    Production: https://api.worldbank.org/posit-mai/conversationalai/
MAI_BASE_URL=
# 2) mAI endpoint of the model provider (OpenAI, Claude or Gemini), same
#    environment as the gateway URL. See README for the six endpoints.
MAI_ENDPOINT=
# 3) Model name. Optional; must belong to MAI_ENDPOINT's provider.
#    Defaults: gpt-5.6-luna (OpenAI), gemini-3.8-flash (Gemini), claude-haiku-5-5 (Claude).
MAI_MODEL=

# --- Call behaviour (defaults shown) ---
# Per-attempt request timeout in seconds (above 0), and how many times (0 to
# 5) a retryable failure is retried. Connection failures and HTTP
# 408/409/425/429/5xx use every retry; a read timeout or dropped connection,
# which the model may already be billing, is retried at most once. One call,
# retries included, ends after timeout x (retries + 1) seconds, at most 30
# minutes.
PCN_AI_TIMEOUT_SECONDS=600
PCN_AI_MAX_RETRIES=2
# Optional output cap per call; unset = model default (Claude: 8192).
PCN_AI_MAX_OUTPUT_TOKENS=

# --- Fake provider knobs ---
# Simulated latency in seconds, and comma-separated field, dimension or
# criterion ids whose calls fail with a retryable error ("*" fails every call).
PCN_AI_FAKE_DELAY_SECONDS=0
PCN_AI_FAKE_FAIL=

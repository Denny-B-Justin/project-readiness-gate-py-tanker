# Copy to .env (gitignored) and fill in. Variables already set in the
# environment take precedence over this file. Every variable is optional.

# Which model client answers: "openrouter" (default) or "fake" (offline,
# deterministic replies; no key needed). With "openrouter" and no key the
# app refuses to start.
PCN_AI_PROVIDER=openrouter

# OpenRouter credentials and model. The key is required by the openrouter
# provider only. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Per-attempt request timeout in seconds (above 0), and how many times (0 to
# 5) a retryable failure is retried. Connection failures and HTTP
# 408/409/429/5xx use every retry; a read timeout or dropped connection,
# which the model may already be billing, is retried at most once. One call,
# retries included, ends after timeout x (retries + 1) seconds, at most 30
# minutes.
PCN_AI_TIMEOUT_SECONDS=600
PCN_AI_MAX_RETRIES=2

# Optional comma-separated OpenRouter provider slugs to try in order,
# e.g. "openai,azure". Empty leaves routing to OpenRouter.
PCN_AI_PROVIDER_ORDER=

# Fake-provider knobs: simulated latency in seconds, and comma-separated
# field, dimension or criterion ids whose calls fail with a retryable error
# ("*" fails every call).
PCN_AI_FAKE_DELAY_SECONDS=0
PCN_AI_FAKE_FAIL=
